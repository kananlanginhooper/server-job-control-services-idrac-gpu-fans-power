# ONE settings file for every service in this repo. Copy to .env (gitignored) in each clone and fill in.
# Lookup per key: <HOST>_KEY first, then KEY (HOST = the machine's short hostname, upper-cased, e.g. MYHOST_ROLE),
# so the same file works on every server. Adding a server = adding its <HOST>_ lines, no code change.

# --- How settings are found (lib/svcenv.py, lib/svcenv.sh) ---
# Every service reads THIS one file (repo root .env, gitignored). For a key NAME it tries, in order:
#   <HOST>_NAME then NAME, each from the process environment first, then from this file; then the code's default.
#   <HOST> = this server's short hostname, upper-cased, non-alphanumerics -> "_" (a server "gpu-box" reads GPU_BOX_ROLE).
# So one file serves every server: shared values as NAME=, per-server ones as <HOST>_NAME= (examples below as # <HOST>_...).
# Another file instead of this one (tests use tests/empty.env):
# SERVICES_ENV_FILE=/path/to/.env

# --- Hub dashboard API (run modes, power targets, throttle, caps, Tasks) ---
HUB_API_URL=http://<hub address>:8090
# only this address may POST /runprofile to a dash-agent
DASH_CLIENT_IP=<hub address>

# --- How the dashboard names the hosts in its JSON (/api/throttle hosts, /api/powertarget "<key>_w") ---
# the server with the DCMI whole-server cap
HUB_KEY=hub
# the server with RAPL package caps
GPU_SERVER_KEY=gpu-server
# the GPU power-limit lever
GPU_THROTTLE_KEY=gpu-server-gpu

# --- Per-server role and paths (repeat with each server's <HOST>_ prefix) ---
# fan-control: which hardware profile to run
# <HOST>_ROLE=hub | gpu-server
# its key in the dashboard's per-host JSON
# <HOST>_HOST_KEY=<its key above>
# copy services/fan-control/component-limits.example.json
# <HOST>_LIMITS_FILE=/usr/local/etc/component-limits.json
# <HOST>_PERCCLI=/usr/local/sbin/perccli64
# peak-power; may carry an "env LD_LIBRARY_PATH=..." prefix
# <HOST>_IPMITOOL_CMD=ipmitool
# 0 where the dashboard doesn't manage the CPU caps
# <HOST>_AGENT_POWERCAPS=1
# the unit gpu-switch stops/starts
# <HOST>_OLLAMA_UNIT=ollama
# gpu-init power cap
# <HOST>_GPU_POWER_W=<watts>
# <HOST>_GPU_WATCHDOG_MATCH=<text in nvidia-smi -L for the watched card>
# <HOST>_WIFI_GATEWAYS="<connection>=<gateway ip> <connection>=<gateway ip>"
# <HOST>_SSD_WRITE_CACHE_SERIALS="<serial> <serial>"

# --- Agents ---
# each GPU host's dash-agent (:8091), per server; read by the dashboard, not by this repo's code
# <HOST>_AGENT_URL=http://<that server's address>:8091
# the agent gpu-perf tables
GPU_PERF_AGENT_URL=http://<gpu server address>:8091

# --- power-guard fallback RAPL read over ssh (empty = no fallback) ---
GPU_SERVER_SSH=<user>@<gpu server address>
SSH_KEY=~/.ssh/id_ed25519

# --- Metrics DB (gpu_perf table) ---
RECOVERY_DB_HOST=<hub address>
RECOVERY_DB_PORT=3306
RECOVERY_DB_NAME=<db name>
RECOVERY_DB_USER=<project user>
RECOVERY_DB_PASSWORD=<never committed>
# optional <db>.<table> of LLM calls for per-minute token throughput
GPU_PERF_CALLS_TABLE=

# --- GPU workers ---
WHISPER_BIND=127.0.0.1
# or cuda
WHISPER_DEVICE=cpu
WHISPER_MODELS=/opt/server-services/whisper-server/models
WHISPER_PYTHON=<venv>/bin/python
VISION_BASE=/opt/server-services/vision-server
VISION_PYTHON=<venv>/bin/python

# --- BMC (iDRAC) access for out-of-band control (the current services use in-band ipmitool and need none) ---
# per server with a BMC; the password lives only in the real .env, never in git
# <HOST>_IDRAC_HOST=<bmc address>
# <HOST>_IDRAC_USER=<bmc user>
# <HOST>_IDRAC_PASSWORD=<never committed>

# --- taskrunner (its own unit; local Postgres over the socket, peer auth) ---
TASKRUNNER_DSN=dbname=taskrunner
TASKRUNNER_PORT=8098
# time zone for at_times schedules (empty = the server's local time); same on every server keeps slots aligned
TASKRUNNER_TZ=
# task_runs older than this many days are pruned hourly (each task's latest run is kept); 0 = keep everything
TASKRUNNER_KEEP_DAYS=30
# where each task's log goes (<task>.<instance>.log)
TASKRUNNER_LOGS=~/taskrunner/logs
# power target for the Low Power gate; empty = HUB_API_URL + /api/powertarget
TASKRUNNER_POWER_URL=
# the hub's run broker (services/run-broker); empty = no broker, the local table only (as before)
TASKRUNNER_BROKER_URL=
# <HOST>_TASKRUNNER_BROKER_URL=http://<hub address>:8099/api/v1/agent
# this server's name at the broker (default: the short hostname, lower case)
# <HOST>_TASKRUNNER_BROKER_HOST=<name>

# --- run broker (services/run-broker; hub only, its own unit; tables in schema broker of the hub's taskrunner database) ---
RUN_BROKER_DSN=dbname=taskrunner
RUN_BROKER_PORT=8099
# the servers it places on, in preference order; slots = how many broker rows per lane at once
RUN_BROKER_HOSTS={"<hub>": {"cpu_slots": 4, "gpu_slots": 0}, "<gpu server>": {"cpu_slots": 2, "gpu_slots": 1, "gpu_vram_gb": 11}}
# servers whose GPU is lent out (space- or comma-separated): GPU requests wait, CPU work still goes there
RUN_BROKER_GPU_HELD=
# 1 = also place 'requested' rows; empty = only rows accepted as 'queued' with no placed_task
RUN_BROKER_AUTO_ACCEPT=
# failed runs in a row before a request is marked failed and withdrawn
RUN_BROKER_MAX_FAILS=3
# where every server keeps its repo clones (a request's repo + workdir go under it)
RUN_BROKER_CODE_ROOT=~/server-projects
# 1 = place task_requests on the runners; empty = work queues only
RUN_BROKER_PLACE_REQUESTS=
# a claimed work item goes back to ready when its worker hasn't beaten for this many seconds
RUN_BROKER_LEASE_S=120
# a reservation: until this time (ISO 8601 with offset) every GPU takes priority-queue work only; empty = none
RUN_BROKER_RESERVE_UNTIL=
# who it's for and why (shown in /status)
RUN_BROKER_RESERVE_FOR=
# the dashboard wrapper's tab list: tab order ranks standard and backup work (the broker reads it every minute)
RUN_BROKER_TABS_URL=http://<wrapper address>:8097/api/tabs

# --- GPU worker (services/gpu-worker; one per GPU, a continuous task-runner row on that server) ---
# the broker's agent API; empty = TASKRUNNER_BROKER_URL
# <HOST>_GPU_WORKER_BROKER_URL=http://<hub address>:8099/api/v1/agent
# this server's name at the broker (default: the short hostname, lower case) and the GPU's name (default <host>-gpu0)
# <HOST>_GPU_WORKER_HOST=<name>
# <HOST>_GPU_WORKER_GPU=<host>-gpu0
# models this GPU serves, own first, then fallbacks it can also load
# <HOST>_GPU_WORKER_MODELS=<model:tag>,<model:tag>
GPU_WORKER_OLLAMA=http://127.0.0.1:11434
# 1 = every layer on the GPU or the call fails; checked after every call (a model spilling into RAM is unusable)
# <HOST>_GPU_WORKER_GPU_ONLY=1
# the queues this GPU takes, in the broker's order (empty = all); e.g. backup for a small GPU
# <HOST>_GPU_WORKER_QUEUES=backup
# parallel calls (match OLLAMA_NUM_PARALLEL)
GPU_WORKER_SLOTS=1
# seconds of claimed work held locally (one batch claim; keep short so priority changes take effect quickly)
GPU_WORKER_QUEUE_S=60
# how often finished results go back to the broker (leases renew every 10 s)
GPU_WORKER_SYNC_S=2
# how long Ollama keeps the model loaded after a call (an item's own keep_alive wins)
GPU_WORKER_KEEP_ALIVE=30m
# seconds with no byte from Ollama (load + prefill, then between tokens) before the item is retried: a dead runner
GPU_WORKER_STALL_S=600
# after a spill into RAM, seconds before this GPU claims that model again
GPU_WORKER_SPILL_BACKOFF_S=600

# --- agent API (contracts/agent-api.md): the per-server agent pulls its orders from the control container ---
# base URL of the container (transition: the Recovery stack on :8100; later :8090). Empty = HUB_API_URL
AGENT_API_URL=
# one bearer token per server (the container keeps only its SHA-256); never commit a real one
# <HOST>_AGENT_TOKEN=<random token>
# units the container may restart on that server (space-separated); empty = none
# <HOST>_AGENT_UNITS=<unit> <unit>
# GPUs this server owns (agent-api 10.4/10.8; not built yet): its Ollama instances, its units, and the job lock that claims it
# <HOST>_GPUS={"<host>-gpu0": {"ollama": ["http://127.0.0.1:11434"], "units": ["<unit>"], "lock": "<lock name>"}}

# --- sjc-agent (services/sjc-agent, runs in Docker; paths are as mounted in the container) ---
# the broker runs with the dashboard (its compose, hub profile)
SJC_MQTT_HOST=<broker address>
SJC_MQTT_PORT=1883
SJC_MQTT_PREFIX=sjc
# filesystem space and software RAID are published every this many seconds (sjc/<host>/disks)
SJC_DISKS_EVERY_S=60
# SMART + kernel errors (sjc/<host>/health): set by compose.health.yaml (privileged, servers only); every this many seconds
# SJC_HEALTH=1
SJC_HEALTH_EVERY_S=600
# set by compose.yaml (paths inside the container): the host's / (read-only, for filesystem space) and its /dev/shm
# SJC_HOST_ROOT=/host/root
# SJC_HOST_SHM=/host/shm
# default: HOST_KEY, else the short hostname
# <HOST>_SJC_HOST=<name in topics>
# only on servers with a GPU (empty = none)
# <HOST>_SJC_NVIDIA_SMI=nvidia-smi
# 1 = only read the GPU, refuse gpu_limit (while the GPU is lent to another project)
# <HOST>_SJC_GPU_READONLY=1
# or /host/shm/... where fan-control keeps it in /dev/shm
# <HOST>_SJC_FAN_CONTROL_STATE=/host/run/fan-control.json
# <HOST>_SJC_RUN_PROFILE_FILE=/host/run/run-profile.json
# <HOST>_SJC_LIMITS_FILE=/host/etc/component-limits.json
SJC_THROTTLE_FILE=/host/shm/power-throttle.json
# ipmitool command (in-band); may carry an "env LD_LIBRARY_PATH=..." prefix
# <HOST>_SJC_IPMITOOL=ipmitool
# where the BMC sensor list is cached between reads
SJC_SDR_CACHE=/tmp/sjc-sdr.cache
# prefix for host commands outside a container (e.g. "sudo -n"); empty in the container
SJC_SUDO=
# /proc as mounted in the container, for system metrics
SJC_HOST_PROC=/host/proc
# systemd unit to ask about fan-control (empty in a container: no systemd there)
SJC_FAN_CONTROL_UNIT=
# only on the server that runs the power scaler: its state file and unit
# <HOST>_SJC_SCALER_STATE=/host/run/<scaler state>.json
# <HOST>_SJC_SCALER_UNIT=<scaler unit>
# host folder holding that state file; compose.hub.yaml mounts it at /host/scaler (export it before `docker compose up`)
# <HOST>_SJC_SCALER_DIR=<host folder>
# publish intervals, seconds
SJC_SENSOR_EVERY_S=5
SJC_POWER_EVERY_S=1
SJC_GPU_EVERY_S=2
SJC_SAFETY_EVERY_S=5
SJC_SYSTEM_EVERY_S=5
# fan-control state older than this counts as "not running"
SJC_CONTROLLER_STALE_S=30
# a manual fan % hands back to Dell auto after this
SJC_MANUAL_LEASE_S=600
# lowest manual fan % accepted
SJC_MANUAL_MIN_PCT=20
# the agent's local HTTP port
SJC_PORT=8000
# optional: forward other /api/* calls to this base URL; empty = none
SJC_LEGACY_API=
# POSTs accepted only from these address prefixes (comma-separated)
SJC_CONTROL_NETS=<lan prefix>.,127.
# dev only: run every command and file read over `ssh <this>` (empty on servers)
SJC_REMOTE=

# power-guard: where its config, state and log live (the dashboard throttle chart reads guard.log there)
# <HOST>_POWER_GUARD_DIR=~/power-guard

# --- link-pusher (services/link-pusher; standard: SERVER-LINKS.md): push /link/<self>-<to> to <to> over SSH ---
# per server: "<to>:<cap KB/s>" for each outbox it sends from; 0 = uncapped. The <to>-link SSH alias must exist.
# A server on a slow link: give every sender to it a share of its inbound cap (the shares add up to the cap), and
# set LINK_SERIAL=1 on it so its own outboxes push one at a time at its outbound cap.
# Set these per server with its <HOST>_ prefix; the base keys stay empty/off:
# <HOST>_LINK_TARGETS=<to>:0 <slow host>:1000
# <HOST>_LINK_SERIAL=1
# outboxes this server pushes: "<to>:<cap KB/s>" separated by spaces (empty = the pusher exits with a message)
LINK_TARGETS=
# 1 = push one outbox at a time (a server on a capped link); 0 = all outboxes in parallel
LINK_SERIAL=0
# the folder that holds /link/<from>-<to>
LINK_ROOT=/link
# full sweep of every outbox (inotify covers the rest)
LINK_SWEEP_S=300
# push a file only after it has been unchanged this long and nothing has it open for writing
LINK_SETTLE_S=60
# rsync gives up on a push after this many seconds without I/O (a dropped link); the push is retried with back-off
LINK_IO_TIMEOUT_S=300
# status JSON per outbox and inbox (files, bytes, oldest age, last push, last error), rewritten every 30 s
LINK_STATUS_FILE=~/link-pusher/status.json
# the status flags an outbox past either threshold
LINK_WARN_GB=50
LINK_WARN_AGE_H=24

# --- metrics recorder (services/metrics-recorder; hub only): MQTT state -> 1-minute history in Postgres, read API ---
METRICS_DSN=dbname=server_metrics
METRICS_PORT=8108
# the rules file (what to record, how buckets combine, tiers and keep times); empty = metrics-rules.json next to the script
METRICS_RULES=
# one-time backfill from the classic hub (backfill_hub_stats.py): the servers with a BMC, the hosts with a GPU, and the
# MySQL client file holding the hub's credentials
METRICS_BACKFILL_BMC_HOSTS=
METRICS_BACKFILL_GPU_HOSTS=
METRICS_BACKFILL_MYSQL_CNF=~/.my.cnf
