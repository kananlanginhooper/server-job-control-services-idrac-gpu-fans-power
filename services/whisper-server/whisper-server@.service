[Unit]
Description=Whisper transcription worker on port %i (stateless HTTP POST /transcribe)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
# needs a venv with faster-whisper; WHISPER_PYTHON in the repo .env points at its python
ExecStart=/bin/bash -c '. @REPO@/lib/svcenv.sh; exec $(svc_env WHISPER_PYTHON python3) @REPO@/services/whisper-server/whisper_server.py %i 10'
# on-failure, not always: a power hook that stops it on purpose must leave it stopped
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
