# ONE settings file for every service in this repo. Copy to .env (gitignored) in each clone and fill in.
# Lookup per key: <HOST>_KEY first, then KEY (HOST = the machine's short hostname, upper-cased, e.g. MYHOST_ROLE),
# so the same file works on every server. Adding a server = adding its <HOST>_ lines, no code change.

# --- Hub dashboard API (run modes, power targets, throttle, caps, Tasks) ---
HUB_API_URL=http://<hub address>:8090
# only this address may POST /runprofile to a dash-agent
DASH_CLIENT_IP=<hub address>

# --- How the dashboard names the hosts in its JSON (/api/throttle hosts, /api/powertarget "<key>_w") ---
# the server with the DCMI whole-server cap
HUB_KEY=hub
# the server with RAPL package caps
GPU_SERVER_KEY=gpu-server
# the GPU power-limit lever
GPU_THROTTLE_KEY=gpu-server-gpu

# --- Per-server role and paths (repeat with each server's <HOST>_ prefix) ---
# fan-control: which hardware profile to run
# <HOST>_ROLE=hub | gpu-server
# its key in the dashboard's per-host JSON
# <HOST>_HOST_KEY=<its key above>
# copy services/fan-control/component-limits.example.json
# <HOST>_LIMITS_FILE=/usr/local/etc/component-limits.json
# <HOST>_PERCCLI=/usr/local/sbin/perccli64
# peak-power; may carry an "env LD_LIBRARY_PATH=..." prefix
# <HOST>_IPMITOOL_CMD=ipmitool
# 0 where the dashboard doesn't manage the CPU caps
# <HOST>_AGENT_POWERCAPS=1
# the unit gpu-switch stops/starts
# <HOST>_OLLAMA_UNIT=ollama
# gpu-init power cap
# <HOST>_GPU_POWER_W=<watts>
# <HOST>_GPU_WATCHDOG_MATCH=<text in nvidia-smi -L for the watched card>
# <HOST>_WIFI_GATEWAYS="<connection>=<gateway ip> <connection>=<gateway ip>"
# <HOST>_SSD_WRITE_CACHE_SERIALS="<serial> <serial>"

# --- Agents ---
# read by the dashboard
GPUSRV_AGENT_URL=http://<gpu server address>:8091
# read by the dashboard
TUG_AGENT_URL=http://<gpu desktop address>:8091
# the agent gpu-perf tables
GPU_PERF_AGENT_URL=http://<gpu server address>:8091

# --- power-guard fallback RAPL read over ssh (empty = no fallback) ---
GPU_SERVER_SSH=<user>@<gpu server address>
SSH_KEY=~/.ssh/id_ed25519

# --- Metrics DB (gpu_perf table) ---
RECOVERY_DB_HOST=<hub address>
RECOVERY_DB_PORT=3306
RECOVERY_DB_NAME=<db name>
RECOVERY_DB_USER=<project user>
RECOVERY_DB_PASSWORD=<never committed>
# optional <db>.<table> of LLM calls for per-minute token throughput
GPU_PERF_CALLS_TABLE=

# --- GPU workers ---
WHISPER_BIND=127.0.0.1
# or cuda
WHISPER_DEVICE=cpu
WHISPER_MODELS=/opt/server-services/whisper-server/models
WHISPER_PYTHON=<venv>/bin/python
VISION_BASE=/opt/server-services/vision-server
VISION_PYTHON=<venv>/bin/python

# --- BMC (iDRAC) access for out-of-band control (the current services use in-band ipmitool and need none) ---
R730_IDRAC_HOST=<bmc address>
R730_IDRAC_USER=<bmc user>
R730_IDRAC_PASSWORD=
GPUSRV_IDRAC_HOST=<bmc address>
GPUSRV_IDRAC_USER=<bmc user>
GPUSRV_IDRAC_PASSWORD=

# --- taskrunner (its own unit; local Postgres over the socket, peer auth) ---
TASKRUNNER_DSN=dbname=taskrunner
TASKRUNNER_PORT=8098

# --- agent API (contracts/agent-api.md): the per-server agent pulls its orders from the control container ---
# base URL of the container (transition: the Recovery stack on :8100; later :8090). Empty = HUB_API_URL
AGENT_API_URL=
# one bearer token per server (the container keeps only its SHA-256); never commit a real one
R730_AGENT_TOKEN=<random token>
GPUSRV_AGENT_TOKEN=<random token>
TUG_AGENT_TOKEN=<random token>
# units the container may restart on that server (space-separated); empty = none
R730_AGENT_UNITS=
GPUSRV_AGENT_UNITS=
TUG_AGENT_UNITS=

# --- sjc-agent (services/sjc-agent, runs in Docker; paths are as mounted in the container) ---
# the broker runs with the dashboard (its compose, hub profile)
SJC_MQTT_HOST=<broker address>
SJC_MQTT_PORT=1883
SJC_MQTT_PREFIX=sjc
# default: HOST_KEY, else the short hostname
# <HOST>_SJC_HOST=<name in topics>
# only on servers with a GPU (empty = none)
# <HOST>_SJC_NVIDIA_SMI=nvidia-smi
# or /host/shm/... where fan-control keeps it in /dev/shm
# <HOST>_SJC_FAN_CONTROL_STATE=/host/run/fan-control.json
# <HOST>_SJC_RUN_PROFILE_FILE=/host/run/run-profile.json
# <HOST>_SJC_LIMITS_FILE=/host/etc/component-limits.json
SJC_THROTTLE_FILE=/host/shm/power-throttle.json
# a manual fan % hands back to Dell auto after this
SJC_MANUAL_LEASE_S=600

# power-guard: where its config, state and log live (the dashboard throttle chart reads guard.log there)
# <HOST>_POWER_GUARD_DIR=~/power-guard

# --- link-pusher (services/link-pusher; standard: SERVER-LINKS.md): push /link/<self>-<to> to <to> over SSH ---
# per server: "<to>:<cap KB/s>" for each outbox it sends from; 0 = uncapped. The <to>-link SSH alias must exist.
# A server on a slow link: give every sender to it a share of its inbound cap (the shares add up to the cap), and
# set LINK_SERIAL=1 on it so its own outboxes push one at a time at its outbound cap.
# Set these per server with its <HOST>_ prefix; the base keys stay empty/off. Example for a host named MYHOST:
# MYHOST_LINK_TARGETS=<to>:0 <slow host>:1000
# MYHOST_LINK_SERIAL=1
# outboxes this server pushes: "<to>:<cap KB/s>" separated by spaces (empty = the pusher exits with a message)
LINK_TARGETS=
# 1 = push one outbox at a time (a server on a capped link); 0 = all outboxes in parallel
LINK_SERIAL=0
# the folder that holds /link/<from>-<to>
LINK_ROOT=/link
# full sweep of every outbox (inotify covers the rest)
LINK_SWEEP_S=300
# push a file only after it has been unchanged this long and nothing has it open for writing
LINK_SETTLE_S=60
# rsync gives up on a push after this many seconds without I/O (a dropped link); the push is retried with back-off
LINK_IO_TIMEOUT_S=300
# status JSON per outbox and inbox (files, bytes, oldest age, last push, last error), rewritten every 30 s
LINK_STATUS_FILE=~/link-pusher/status.json
# the status flags an outbox past either threshold
LINK_WARN_GB=50
LINK_WARN_AGE_H=24
