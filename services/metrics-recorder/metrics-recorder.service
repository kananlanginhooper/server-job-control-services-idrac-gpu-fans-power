[Unit]
Description=Metrics recorder: MQTT agent state -> 1-minute history in Postgres (hub only, 2026-11-01)
After=network-online.target postgresql.service docker.service
Wants=network-online.target postgresql.service

[Service]
User=svc
# the shared settings file (install.sh fills in the clone's path)
Environment=SERVICES_ENV_FILE=/path/to/repo/.env
ExecStart=/usr/bin/python3 -B /opt/metrics-recorder/metrics_recorder.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
